<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Login' }) %>
</head>
<body>
  <div class="login-page">
    <div class="login-glow-1"></div>
    <div class="login-glow-2"></div>
    <div class="login-card">
      <div class="login-logo-chip">
        <img class="login-logo-img" src="https://pub-da9fd1c19b8e45d691d67626b9a7ba6d.r2.dev/1788721257792-0aceea04-729d-4fea-9c19-06b2ebc9f83a-(1)-(1).png" alt="PayCrypto" />
      </div>
      <div class="login-title">Welcome back</div>
      <div class="login-sub">Sign in to manage your store.</div>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="post" action="/admin/login">
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required autofocus />
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%">Sign in</button>
      </form>

      <div class="login-foot">PayCrypto · Secure access</div>
    </div>
  </div>
</body>
</html>
