<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: product ? 'Edit product' : 'New product' }) %>
</head>
<body>
  <div class="shell">
    <%- include('../partials/nav', { active: 'products' }) %>
    <main class="main">
      <div class="page-header">
        <div>
          <div class="page-title"><%= product ? 'Edit product' : 'New product' %></div>
          <% if (product && product.id) { %><div class="page-sub">/?product=<%= product.slug %></div><% } %>
        </div>
        <% if (product) { %>
          <form method="post" action="/admin/products/<%= product.id %>/delete" onsubmit="return confirm('Delete this product?')">
            <button type="submit" class="btn btn-danger">Delete</button>
          </form>
        <% } %>
      </div>

      <% if (errors) { %>
        <div class="alert alert-error"><% errors.forEach(function(e) { %><div><%= e %></div><% }) %></div>
      <% } %>

      <form method="post" action="<%= product ? `/admin/products/${product.id}` : '/admin/products/new' %>">
        <div class="card">
          <div class="grid grid-2">
            <div class="field">
              <label>Nome do produto</label>
              <input type="text" name="name" value="<%= product ? product.name : '' %>" required />
            </div>
            <div class="field">
              <label>Preço (USD)</label>
              <input type="number" step="0.01" min="0" name="price" value="<%= product ? (typeof product.price === 'number' ? (product.price/100).toFixed(2) : product.price) : '' %>" required />
            </div>
            <div class="field">
              <label>Custo (USD)</label>
              <input type="number" step="0.01" min="0" name="cost" value="<%= product && product.cost ? (typeof product.cost === 'number' ? (product.cost/100).toFixed(2) : product.cost) : '' %>" />
            </div>
            <div class="field">
              <label>Imagem (URL)</label>
              <input type="text" name="imageUrl" value="<%= product ? (product.imageUrl || '') : '' %>" placeholder="https://..." />
            </div>
          </div>
        </div>

        <% if (product && product.id) { %>
          <div class="section-title">Tradução do checkout</div>
          <% translationLocales.forEach(function(locale) { %>
            <% const t = (typeof translationsByLocale !== 'undefined' && translationsByLocale[locale]) || {}; %>
            <div class="card" style="margin-bottom:14px">
              <div class="stat-label" style="margin-bottom:12px"><%= translationLabels[locale] %></div>
              <div class="grid grid-2">
                <div class="field">
                  <label>Nome do produto</label>
                  <input type="text" name="translation_<%= locale %>_name" value="<%= t.name || '' %>" placeholder="<%= product.name %>" />
                </div>
                <div class="field">
                  <label>Título do checkout</label>
                  <input type="text" name="translation_<%= locale %>_checkoutTitle" value="<%= t.checkoutTitle || '' %>" placeholder="<%= product.checkoutTitle || '' %>" />
                </div>
                <div class="field">
                  <label>Subtítulo do checkout</label>
                  <input type="text" name="translation_<%= locale %>_checkoutSubtitle" value="<%= t.checkoutSubtitle || '' %>" placeholder="<%= product.checkoutSubtitle || '' %>" />
                </div>
                <div class="field">
                  <label>Texto do botão</label>
                  <input type="text" name="translation_<%= locale %>_checkoutButtonText" value="<%= t.checkoutButtonText || '' %>" placeholder="<%= product.checkoutButtonText || '' %>" />
                </div>
                <div class="field">
                  <label>Descrição curta</label>
                  <input type="text" name="translation_<%= locale %>_shortDescription" value="<%= t.shortDescription || '' %>" placeholder="<%= product.shortDescription || '' %>" />
                </div>
                <div class="field">
                  <label>Título da página de sucesso</label>
                  <input type="text" name="translation_<%= locale %>_successPageTitle" value="<%= t.successPageTitle || '' %>" placeholder="<%= product.successPageTitle || '' %>" />
                </div>
              </div>
              <div class="field" style="margin-bottom:0">
                <label>Descrição</label>
                <textarea name="translation_<%= locale %>_description" rows="3" placeholder="<%= product.description || '' %>"><%= t.description || '' %></textarea>
              </div>
            </div>
          <% }) %>
        <% } %>

        <button type="submit" class="btn btn-primary" style="margin-top:4px">Salvar produto</button>
      </form>

      <% if (product && product.id) { %>
        <div class="section-title" style="margin-top:24px">Preços por moeda</div>
        <div class="card table-wrap" style="margin-bottom:14px">
          <table>
            <thead><tr><th>Moeda</th><th>Preço</th><th>Preço "de"</th><th></th></tr></thead>
            <tbody>
              <% product.prices.forEach(function(p) { %>
                <tr>
                  <td><%= p.currency %></td>
                  <td><%= (p.price/100).toFixed(2) %></td>
                  <td><%= p.compareAtPrice ? (p.compareAtPrice/100).toFixed(2) : '—' %></td>
                  <td>
                    <form method="post" action="/admin/products/<%= product.id %>/prices/<%= p.id %>/delete" onsubmit="return confirm('Remover este preço?')">
                      <button type="submit" class="btn btn-ghost btn-sm">Remover</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
              <% if (product.prices.length === 0) { %>
                <tr><td colspan="4" class="stat-sub">Nenhum preço fixo por moeda — usando o preço padrão (USD) acima.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="card">
          <div class="stat-label" style="margin-bottom:12px">Adicionar / atualizar preço por moeda</div>
          <form method="post" action="/admin/products/<%= product.id %>/prices">
            <div class="grid grid-3">
              <div class="field">
                <label>Moeda (ex: EUR)</label>
                <input type="text" name="currency" maxlength="3" minlength="3" placeholder="EUR" required style="text-transform:uppercase" />
              </div>
              <div class="field">
                <label>Preço fixo</label>
                <input type="number" step="0.01" min="0" name="price" required />
              </div>
              <div class="field">
                <label>Preço "de" (opcional)</label>
                <input type="number" step="0.01" min="0" name="compareAtPrice" />
              </div>
            </div>
            <button type="submit" class="btn btn-ghost">Salvar preço</button>
          </form>
        </div>

        <div class="section-title" style="margin-top:24px">Link de Checkout</div>
        <div class="card">
          <div class="checkout-url-box">
            <input type="text" readonly value="<%= `${req.protocol}://${req.get('host')}/?product=${product.slug}` %>" id="checkoutUrl" />
            <button type="button" class="btn btn-ghost" onclick="navigator.clipboard.writeText(document.getElementById('checkoutUrl').value).then(()=>this.textContent='Copiado!')">Copiar</button>
          </div>
        </div>
      <% } %>
    </main>
  </div>
</body>
</html>
